# For npm run dev, /api is proxied to FastAPI at http://127.0.0.1:8000.
# Optional: use a different backend proxy target (read by Vite on startup):
# FASTAPI_PROXY_TARGET=http://127.0.0.1:8000

# For a separately hosted production frontend, configure its API URL:
# VITE_API_BASE_URL=https://api.yourdomain.com
